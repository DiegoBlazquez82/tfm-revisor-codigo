diff --git a/app/prices.py b/app/prices.py
new file mode 100644
--- /dev/null
+++ b/app/prices.py
@@ -0,0 +1,5 @@
+VAT_RATE = 0.21
+
+
+def price_with_vat(net_price: float) -> float:
+    return round(net_price * (1 + VAT_RATE), 2)
