+import sqlite3
+
+
+def find_user(conn: sqlite3.Connection, name: str):
+    cursor = conn.cursor()
+    query = f"SELECT id, email FROM users WHERE name = '{name}'"
+    cursor.execute(query)
+    return cursor.fetchall()
